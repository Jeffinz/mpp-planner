#!/bin/sh
# ABOUTME: Runs Playwright end-to-end tests against the Auth and Firestore emulators (needs Java 11+).
# ABOUTME: Usage: sh scripts/test-e2e [playwright args]. Report: npx playwright show-report.
set -e
cd "$(dirname "$0")/.."
if [ -z "$JAVA_HOME" ]; then
  for dir in "$HOME"/.local/jdk/*/; do JAVA_HOME="${dir%/}"; break; done
fi
if [ ! -x "$JAVA_HOME/bin/java" ] && [ ! -x "$JAVA_HOME/bin/java.exe" ]; then
  echo "test-e2e: no Java found. Set JAVA_HOME or unpack a JDK into ~/.local/jdk/." >&2
  exit 1
fi
export JAVA_HOME PATH="$JAVA_HOME/bin:$PATH"
npx firebase emulators:exec --only auth,firestore --project demo-mpp-planner \
  "npx playwright test $*"
